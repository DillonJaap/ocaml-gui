profile = janestreet
margin = 100
sequence-blank-line=preserve-one
exp-grouping=preserve
if-then-else=fit-or-vertical
break-before-in=fit-or-vertical
indicate-multiline-delimiters=closing-on-separate-line
#let-binding-spacing=sparse

# indentation — pinned explicitly (janestreet profile sets these to 2)
cases-exp-indent = 2
extension-indent = 2
function-indent = 2
let-binding-indent = 2
module-indent = 2
stritem-extension-indent = 2
type-decl-indent = 2
