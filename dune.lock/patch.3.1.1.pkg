(version 3.1.1)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml dune)))

(source
 (fetch
  (url
   https://github.com/hannesm/patch/releases/download/v3.1.1/patch-3.1.1.tbz)
  (checksum
   sha256=9b703ef5356f01897ebc8cb2f9774430bb20d3ae93820c46f292227a9d1553f1)))
